# Copy this file to .env and fill in your own keys.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
# gemini-2.5-* đã đóng với người dùng mới; Gemini 3.x ở gói Free dùng tốt cho nhận diện ảnh.

# Tìm giá thị trường: https://app.tavily.com (1.000 credit/tháng miễn phí, không cần thẻ)
TAVILY_API_KEY=your_tavily_api_key
# basic = 1 credit/truy vấn (~500 lần định giá/tháng), advanced = 2 credit (~250 lần, nội dung chi tiết hơn)
TAVILY_SEARCH_DEPTH=basic

PORT=3000
# If the frontend is hosted on a different origin, set it explicitly, e.g.:
# FRONTEND_ORIGIN=https://reloop.example.com
# If frontend and backend share the same origin, leave FRONTEND_ORIGIN blank.

# --- Tài khoản đăng nhập (không có đăng ký). role: admin | user
AUTH_USERS=[{"username":"admin","password":"doi_mat_khau","role":"admin","name":"Quản trị viên"},{"username":"user1","password":"doi_mat_khau","role":"user","name":"Người dùng 1"}]
# Khóa ký cookie phiên đăng nhập: chuỗi ngẫu nhiên dài, tạo bằng
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_random_secret

# Lưu tin đăng & thống kê trên Vercel: tạo Upstash Redis (Vercel Marketplace hoặc upstash.com, gói Free).
# Bỏ trống khi chạy local -> lưu vào data/db.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hiện nút đăng nhập nhanh (không cần mật khẩu) ở trang đăng nhập. CHỈ dùng khi chạy thử trên máy,
# KHÔNG bật trên Vercel/web công khai vì ai cũng vào được tài khoản admin.
DEMO_LOGIN=false
