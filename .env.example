# Copy this file to .env and fill in your own keys.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

TAVILY_API_KEY=your_tavily_api_key

PORT=3000
# If the frontend is hosted on a different origin, set it explicitly, e.g.:
# FRONTEND_ORIGIN=https://reloop.example.com
# If frontend and backend share the same origin, leave FRONTEND_ORIGIN blank.
